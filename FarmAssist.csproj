<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Путь к папке Dalamud dev -->
  <PropertyGroup>
    <DalamudDevPath>$(AppData)\XIVLauncher\addon\Hooks\dev</DalamudDevPath>
  </PropertyGroup>

  <!-- Ссылки на сборки Dalamud (лежат локально) -->
  <ItemGroup>
    <Reference Include="Dalamud">
      <HintPath>$(DalamudDevPath)\Dalamud.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Lumina">
      <HintPath>$(DalamudDevPath)\Lumina.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Lumina.Excel">
      <HintPath>$(DalamudDevPath)\Lumina.Excel.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Content Include="FarmAssistPlugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!-- Стандартные NuGet пакеты, если нужны (здесь только System.Text.Json уже есть в .NET) -->

</Project>